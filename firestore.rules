rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 密碼 23ian：留言存在 boards/23ian 底下，密碼不對就讀不到也寫不進去
    function valid(d) {
      return d.keys().hasOnly(["who", "text", "tag", "style", "at", "editedAt"])
        && d.who in ["ian", "celine"]
        && d.text is string && d.text.size() > 0 && d.text.size() <= 3000;
    }
    match /boards/{code}/messages/{id} {
      allow read, delete: if code == "23ian";
      allow create: if code == "23ian" && valid(request.resource.data) && request.resource.data.at is timestamp;
      allow update: if code == "23ian" && valid(request.resource.data)
        && request.resource.data.at == resource.data.at
        && request.resource.data.who == resource.data.who;
    }
    // 想一起做的事：雙方都能新增、打勾、刪除
    function validWish(d) {
      return d.keys().hasOnly(["who", "text", "at", "done", "doneAt"])
        && d.who in ["ian", "celine"]
        && d.text is string && d.text.size() > 0 && d.text.size() <= 100
        && d.done is bool;
    }
    match /boards/{code}/wishes/{id} {
      allow read, delete: if code == "23ian";
      allow create: if code == "23ian" && validWish(request.resource.data) && request.resource.data.at is timestamp;
      allow update: if code == "23ian" && validWish(request.resource.data)
        && request.resource.data.at == resource.data.at
        && request.resource.data.who == resource.data.who;
    }
    // 點閱紀錄：只能新增，不能改、不能刪
    match /visits/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(["brand", "model", "at"])
        && request.resource.data.brand is string && request.resource.data.brand.size() < 20
        && request.resource.data.model is string && request.resource.data.model.size() < 40
        && request.resource.data.at == request.time;
    }
  }
}
